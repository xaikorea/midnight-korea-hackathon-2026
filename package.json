{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:regression": "node tests/regression-suite.mjs",
    "test:contracts": "node --test contracts/test.mjs contracts/request-runner.test.mjs",
    "typecheck:sdk": "tsc -p contracts/tsconfig.sdk.json",
    "test:sdk": "node --test contracts/sdk/sdk.test.mjs contracts/sdk/wallet-adapter.test.mjs contracts/sdk/web-source.test.mjs",
    "test:connector": "node tests/dapp-connector.cjs && node tests/dapp-connector-ui.cjs",
    "test:identity-exchange": "node tests/portable-credential.cjs && node tests/vlei-verifier.cjs && node tests/identity-exchange-ui.cjs",
    "test:keycloak": "node tests/keycloak.cjs && node tests/keycloak-ui.cjs",
    "test:openbao": "node tests/openbao.cjs && node tests/openbao-ui.cjs",
    "test:jsonforms": "node tests/jsonforms.cjs && node tests/jsonforms-ui.cjs",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "test:ajv": "node scripts/generate-validators.mjs --check && node tests/ajv-validation.cjs",
    "test:opa": "node tests/opa.cjs",
    "test:opa:live": "node tests/opa-live.cjs",
    "test:review-fixes": "node tests/review-fixes.cjs",
    "test:openbao:live": "node tests/openbao-live.cjs",
    "test:keycloak:live": "node tests/keycloak-live.cjs",
    "test:shared-workspace": "node tests/shared-workspace-api.cjs",
    "midnight:preflight": "node scripts/midnight-preflight.mjs",
    "test:unit": "node tests/unit-suite.mjs",
    "test:verification": "npm run typecheck && npm run typecheck:sdk && npm run check:validators && npm run test:unit && npm run test:contracts && npm run test:sdk",
    "build:nhn": "next build --webpack",
    "start:nhn": "next start --hostname 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@midnight-ntwrk/credential-model": "0.1.0-rc3",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@shadcn/react": "^0.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.12",
    "lucide-react": "^1.31.0",
    "maxmind": "5.0.6",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "npm@11.19.0"
}
